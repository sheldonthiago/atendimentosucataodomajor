# Banco de dados (caminho absoluto para o arquivo SQLite)
DATABASE_URL="file:/caminho/absoluto/para/prisma/dev.db"

# Segredo da sessão — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo de 32 caracteres aleatórios
AUTH_SECRET="troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres"

# Credenciais do administrador do painel
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="senha-forte-aqui"
